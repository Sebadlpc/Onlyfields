# syntax=docker/dockerfile:1.4
FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /build

# Copiar solo los POMs para cachear la capa de dependencias
COPY pom.xml .
COPY seguimiento/pom.xml ./seguimiento/
COPY api-gateway/pom.xml ./api-gateway/
COPY usuarios/pom.xml ./usuarios/
COPY reservas/pom.xml ./reservas/
COPY pos/pom.xml ./pos/
COPY suscripciones/pom.xml ./suscripciones/
COPY inventario/pom.xml ./inventario/
COPY accesos/pom.xml ./accesos/
COPY reportes/pom.xml ./reportes/
COPY configuracion/pom.xml ./configuracion/
COPY notificaciones/pom.xml ./notificaciones/

# Descargar dependencias con cache compartido
COPY .mvn ./.mvn
COPY mvnw .
RUN chmod +x mvnw && sed -i 's/\r$//' mvnw
RUN --mount=type=cache,target=/root/.m2,sharing=locked ./mvnw dependency:go-offline -pl seguimiento -am -q

WORKDIR /build
RUN sed -i 's/\r//' mvnw
RUN chmod +x mvnw
RUN ./mvnw clean package -DskipTests -pl seguimiento -am

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

COPY --from=builder /build/seguimiento/target/ms-seguimiento-1.0.0.jar /app/app.jar

EXPOSE 8087
ENTRYPOINT ["java", "-jar", "/app/app.jar"]